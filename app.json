{
  "expo": {
    "name": " ",
    "slug": "lekhit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splashnepal.png",
    "scheme": "lekhit Guru",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nepal.png",
        "backgroundColor": "#434d57"
      },
      "edgeToEdgeEnabled": true
    },
    "splash": {
      "image": "./assets/images/nepal.png",
      "resizeMode": "contain",
      "backgroundColor": "#434d57"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/nepal.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nepal.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#434d57"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to photo library to select license photos",
          "cameraPermission": "This app needs access to camera to capture license photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}