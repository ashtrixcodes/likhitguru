{
  "expo": {
    "name": "Likhit Guru",
    "slug": "likhit-guru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splashnepal.png",
    "scheme": "likhitguru",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.likhitguru.app",
      "appleTeamId": "Q4XWXYZ123"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nepal.png",
        "backgroundColor": "#091020"
      },
      "navigationBar": {
        "backgroundColor": "#00000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.likhitguru.app"
    },
    "splash": {
      "image": "./assets/images/nepal.png",
      "resizeMode": "contain",
      "backgroundColor": "#091020"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/nepal.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nepal.png",
          "imageWidth": 130,
          "resizeMode": "contain",
          "backgroundColor": "#091020"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to photo library to select license photos",
          "cameraPermission": "This app needs access to camera to capture license photos"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "android_app_id": "ca-app-pub-9520863212221697~5703535199",
          "ios_app_id": "ca-app-pub-9520863212221697~5703535199",
          "androidAppId": "ca-app-pub-9520863212221697~5703535199",
          "iosAppId": "ca-app-pub-9520863212221697~5703535199"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0"
          }
        }
      ],
      "@bacons/apple-targets",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.likhitguru.app.widget",
                  "targetName": "ExamWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.likhitguru.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6361397d-355d-4456-bec5-11cc0e2e9bbb"
      }
    },
    "owner": "likhit-guru"
  }
}
