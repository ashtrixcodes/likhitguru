{
  "expo": {
    "name": "Lekhit Guru",
    "slug": "lekhit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splashnepal.png",
    "scheme": "lekhitguru",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.likhitguru.app",
      "appleTeamId": "Q4XWXYZ123"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nepal.png",
        "backgroundColor": "#434d57"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.likhitguru.app"
    },
    "splash": {
      "image": "./assets/images/nepal.png",
      "resizeMode": "contain",
      "backgroundColor": "#434d57"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/nepal.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nepal.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#434d57"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to photo library to select license photos",
          "cameraPermission": "This app needs access to camera to capture license photos"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9520863212221697~5703535199",
          "iosAppId": "ca-app-pub-9520863212221697~5703535199"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0"
          }
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}